# ==============================================================================
# Emotional Mapping — Environment Configuration Example (.env.example)
#
# INSTRUCTIONS:
# Copy this file to '.env' at the repository root and fill in your actual credentials.
# NEVER commit the actual '.env' file to Git!
# ==============================================================================

# ── Application Environment ───────────────────────────────────────────────────
# Values: development | staging | production
ENV=development

# ── Database (Supabase PostgreSQL) ─────────────────────────────────────────────
# IMPORTANT: Use the Supabase TRANSACTION POOLER URL (port 6543, pgBouncer).
# Direct connections (port 5432) may fail on IPv4-only cloud hosts like Render.
# Format: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Find it: Supabase Dashboard -> Project Settings -> Database -> Connection pooling -> Mode: Transaction -> URI
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Supabase Auth & Storage ───────────────────────────────────────────────────
# Find in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Public publishable / anon key (used for server-side token verification against Supabase Auth)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Secret service-role key (used server-side for backend storage operations, NEVER expose to browser)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ── Google Gemini LLM ─────────────────────────────────────────────────────────
# Get API key from Google AI Studio: https://aistudio.google.com/
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Recommended production Flash model: gemini-2.0-flash (or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Maximum time (in seconds) to wait for a Gemini response before timing out
LLM_TIMEOUT_SECONDS=60

# Thinking level for Gemini 2.0+ models: none | low | medium | high
LLM_THINKING_LEVEL=none

# ── CORS Settings ─────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this backend.
# In production, add your Vercel frontend URL: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ── Application AI Rate Limits ────────────────────────────────────────────────
# Maximum number of Shot Designer generations allowed per user per UTC day
DAILY_AI_GENERATION_LIMIT=20
